@* A View recebe uma coleção de chamados. *@
@model IEnumerable<MiniPortal.Models.Chamado> 

@{
    ViewData["Title"] = "Chamados";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Chamados</h1>
        <p class="text-muted">
            Acompanhe os chamados registrados no sistema.
        </p>
    </div>

    <a asp-controller="Chamados"
       asp-action="Create"
       class="btn btn-primary">
        Novo chamado
    </a>
</div>

@if (!Model.Any()) 
{
    <div class="alert alert-info">
        Nenhum chamado foi cadastrado.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Status</th>
                <th>Data de criação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var chamado in Model) // PERCORRE CADA OBJETO DA LISTA
            {
                <tr>
                    <td>@chamado.Id</td>
                    <td>@chamado.Titulo</td>
                    <td>@chamado.Status</td>
                    <td>@chamado.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}