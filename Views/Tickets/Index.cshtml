@model IEnumerable<MiniPortal.Models.Ticket> 

@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Tickets</h1>
        <p class="text-muted">
            Track tickets registered in the system.
        </p>
    </div>

    <a asp-controller="Tickets"
       asp-action="Create"
       class="btn btn-primary">
        New Ticket
    </a>
</div>

<table id="ticketsTable" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.Status</td>
                <td>@ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <form asp-controller="Tickets" asp-action="Delete" asp-route-id="@ticket.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger text-black" onclick="return confirm('Deseja realmente excluir este ticket?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ticketsTable').DataTable({
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ tickets",
                    infoEmpty: "No tickets available",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    zeroRecords: "No matching tickets found",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                },
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 4 }
                ]
            });
        });
    </script>
}
