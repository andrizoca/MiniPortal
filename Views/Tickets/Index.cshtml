@model IEnumerable<MiniPortal.Models.Ticket> 

@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Tickets</h1>
        <p class="text-muted">
            Track tickets registered in the system.
        </p>
    </div>

    <a asp-controller="Tickets"
       asp-action="Create"
       class="btn btn-primary">
        New Ticket
    </a>
</div>

@if (!Model.Any()) 
{
    <div class="alert alert-info">
        No tickets found.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>@ticket.Title</td>
                    <td>@ticket.Status</td>
                    <td>@ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info text-white">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
